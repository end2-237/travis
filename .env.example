# ---------------------------------------------------------------------
# Travis — variables d'environnement
# Copiez ce fichier en .env.local (jamais commité) et renseignez vos clés.
# ---------------------------------------------------------------------

# URL publique du site — sert aux URL de retour de paiement et aux webhooks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------
# Sans ces trois variables, l'application tourne en mode démonstration :
# catalogue local réduit, profils en mémoire, aucun stockage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Schéma PostgreSQL. Laissez vide (= public) sur une instance dédiée.
# Sur une instance partagée entre plusieurs applications : travis
# — pensez alors à exposer le schéma à PostgREST :
#   PGRST_DB_SCHEMAS=public,travis
SUPABASE_DB_SCHEMA=

# Compartiment de stockage des rapports. Les compartiments sont communs à
# toute l'instance : sur une instance partagée, nommez-le travis-reports.
# Vide (= reports) sur une instance dédiée.
SUPABASE_STORAGE_BUCKET=

# --- Agrégateur de paiement Mobile Money -----------------------------
# Valeurs possibles : monetbil | payunit | (vide = mode démonstration)
PAYMENT_PROVIDER=

# Monetbil
MONETBIL_SERVICE_KEY=
MONETBIL_SERVICE_SECRET=

# PayUnit
PAYUNIT_API_USER=
PAYUNIT_API_PASSWORD=
PAYUNIT_API_KEY=
PAYUNIT_MODE=test
PAYUNIT_WEBHOOK_SECRET=

# --- Back-office -----------------------------------------------------
# Sans ces deux variables, /admin affiche une page d'installation et reste
# inaccessible. Générer le secret : openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Sel de l'empreinte de visite. Le changer réinitialise le comptage des
# visiteurs distincts, sans effet sur les autres mesures.
ANALYTICS_SALT=

# --- Livraison WhatsApp (optionnelle) --------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
